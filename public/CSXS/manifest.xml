<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0" ExtensionBundleId="com.donyaep.DonyTools" ExtensionBundleVersion="__APP_VERSION__"
    ExtensionBundleName="dony Tools" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.donyaep.DonyTools.panel" Version="__APP_VERSION__" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects 2022 (22.0) and above – CEP 11 / Chromium 88. The panel's own
                 floor is CEP 11 (After Effects 2021 / 18.0), raised to 22.0 to keep one
                 support matrix across dony Tools, Layers Pane Plus and Timer Keeper. -->
            <Host Name="AEFT" Version="22.0" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.donyaep.DonyTools.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>dony Tools</Menu>
                    <Geometry>
                        <Size>
                            <Height>400</Height>
                            <Width>350</Width>
                        </Size>
                        <MinSize>
                            <Height>300</Height>
                            <Width>320</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>800</Height>
                            <Width>600</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
